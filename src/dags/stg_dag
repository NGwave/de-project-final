from datetime import datetime
from airflow.decorators import dag, task
from airflow.providers.amazon.aws.hooks.s3 import S3Hook
from airflow.providers.common.sql.hooks.sql import DbApiHook

@dag(
     dag_id='s3_upload_incremental_2022_v4',
    default_args={
        'owner': 'dwh_team',
        'depends_on_past': False
    },
    schedule_interval='@daily',       
    start_date=datetime(2022, 11, 1),  
    end_date=datetime(2022, 11, 10), 
    catchup=True,                     
    max_active_runs=1,                
    tags=['stg'],
)
def s3_load():
    @task
    def download_currencies(ds=None, **kwargs):
        s3_conn_id = "conn_s3"  
        bucket_name = "final-project"
        s3_key = "currencies_history.csv"
        vertica_conn_id ="vertica_conn"
        local_path = "/tmp/currencies_history.csv"

        s3_hook = S3Hook(aws_conn_id=s3_conn_id)
        current_dag_date = datetime.strptime(ds, "%Y-%m-%d").date()
        if s3_hook.check_for_key(key=s3_key, bucket_name=bucket_name):
            s3_object = s3_hook.get_key(key=s3_key, bucket_name=bucket_name)
            s3_file_modified_date = s3_object.last_modified.date()
            if s3_file_modified_date >= current_dag_date:
                print("found a newer version of the currency rates, uploading...")
                s3_hook.get_key(s3_key, bucket_name).download_file(local_path)
                vertica_hook = DbApiHook.get_hook(conn_id=vertica_conn_id)
                conn = vertica_hook.get_conn()
                cursor = conn.cursor()
                cursor.execute("TRUNCATE TABLE VT260501BE9A82__STAGING.currencies;")
                cursor.execute(f"COPY VT260501BE9A82__STAGING.currencies FROM LOCAL '{local_path}' DELIMITER ',' SKIP 1;")
                conn.commit()
                cursor.close()
                conn.close()       

        return local_path

    @task
    def download_transactions_current_batch(ds=None, **kwargs):
        s3_conn_id = "conn_s3"
        vertica_conn_id ="vertica_conn"
        bucket_name = "final-project"
        local_path = "/tmp/transactions_batch_latest.csv"

        s3_hook = S3Hook(aws_conn_id=s3_conn_id)
        vertica_hook = DbApiHook.get_hook(conn_id=vertica_conn_id)

        # батчи в s3 названы номерами, а не числами
        # этот код имитирует загрузку по дням 
        day_str = datetime.strptime(ds, "%Y-%m-%d").strftime('%d')
        batch_number = int(day_str)
        file_key = f"transactions_batch_{batch_number}.csv"
        print(file_key)
        if s3_hook.check_for_key(key=file_key, bucket_name=bucket_name):
            print("transaction batch for current iteration found, uploading...")
            s3_hook.get_key(file_key, bucket_name).download_file(local_path)
            vertica_hook = DbApiHook.get_hook(conn_id=vertica_conn_id)
            conn = vertica_hook.get_conn()
            cursor = conn.cursor()
            cursor.execute("TRUNCATE TABLE VT260501BE9A82__STAGING.transactions;")
            cursor.execute(f"COPY VT260501BE9A82__STAGING.transactions FROM LOCAL '{local_path}' DELIMITER ',' SKIP 1;")
            conn.commit()
            cursor.close()
            conn.close()       



        # код для инкрементальной загрузки по датам, который МОГ БЫ БЫТЬ 
        # file_keys = s3_hook.list_keys(bucket_name=bucket_name, prefix='transactions_batch')
        # for key in file_keys:
        #     obj = s3_hook.get_key(key=key, bucket_name=bucket_name)
        #     load_time = obj.last_modified.date()
        #     if load_time == parsed_date:
        #         file_key = obj['Key']
        #         s3_hook.get_key(file_key, bucket_name).download_file(local_path)    

    # 3. Call the task to add it to the DAG topology
    download_currencies() >> download_transactions_current_batch()

# 4. Instantiate the DAG
s3_load()
